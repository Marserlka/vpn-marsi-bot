# Telegram
BOT_TOKEN=123456:your-bot-token-from-botfather
# Comma-separated Telegram IDs with access to /admin
ADMIN_IDS=111111111,222222222

# Database
DB_URL=sqlite+aiosqlite:///./vpn_marsi.db

# Marzban panel
MARZBAN_BASE_URL=https://your-marzban-domain:8000
MARZBAN_ADMIN_USERNAME=admin
MARZBAN_ADMIN_PASSWORD=change-me
# Name of the VLESS-Reality inbound configured in Marzban (see panel -> Core -> inbounds)
MARZBAN_INBOUND_TAG=VLESS-Reality
# SNI/dest masking domain used by the inbound (informational, must match panel config).
# Must be a foreign-hosted, TLS1.3 site whose real IPs plausibly include your VPS's
# country - do NOT use a domestic-only domain (e.g. vk.com) on a foreign server: DPI
# systems that correlate SNI with known IP ranges (like Russia's TSPU) will flag and
# drop the mismatch, which is exactly what happened in testing.
MARZBAN_SNI_MASK=addons.mozilla.org

# Subscription plans: period_days:price_rub pairs, comma-separated
PLAN_1=30:30
PLAN_2=90:90
PLAN_3=180:180

# Referral bonus granted to the inviter after the referred user's first payment
REFERRAL_BONUS_DAYS=0
REFERRAL_BONUS_AMOUNT=15

# Reminder schedule (do not change unless TZ changes)
REMINDER_DAYS_BEFORE=3,1
