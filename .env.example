# Telegram
BOT_TOKEN=123456:your-bot-token-from-botfather
# Comma-separated Telegram IDs with access to /admin
ADMIN_IDS=111111111,222222222

# Database
DB_URL=sqlite+aiosqlite:///./vpn_marsi.db

# AmneziaWG peer-management agent (primary protocol, see TZ 3.2 — the bot
# provisions AmneziaWG peers via this small sidecar service running on the
# VPS, not through Marzban, which has no native WireGuard support).
# Port 443 on purpose — many bot hosts (incl. BotHost) block outbound to
# non-standard ports; the agent listens on 443 for exactly this reason.
AWG_AGENT_BASE_URL=https://your-vps-domain
AWG_AGENT_TOKEN=change-me

# Marzban panel (kept as a possible future fallback; not used by the current
# activation flow — see AWG_AGENT_* above)
MARZBAN_BASE_URL=https://your-marzban-domain:8000
MARZBAN_ADMIN_USERNAME=admin
MARZBAN_ADMIN_PASSWORD=change-me
# Name of the VLESS-Reality inbound configured in Marzban (see panel -> Core -> inbounds)
MARZBAN_INBOUND_TAG=VLESS-Reality
# SNI/dest masking domain used by the inbound — must be a foreign-hosted,
# TLS1.3 site whose real IPs plausibly include your VPS's country
MARZBAN_SNI_MASK=addons.mozilla.org

# Subscription plans: period_days:price_rub pairs, comma-separated
PLAN_1=30:30
PLAN_2=90:90
PLAN_3=180:180

# Referral: recurring % of every purchase the referred user makes, plus a
# flat day bonus, credited on each of their payments
REFERRAL_BONUS_PERCENT=30
REFERRAL_BONUS_DAYS=3
REFERRAL_CAPTCHA_TIMEOUT_SECONDS=120

SUPPORT_USERNAME=Marserlka

# Legal documents shown before purchase (payment-provider compliance)
PRIVACY_POLICY_URL=https://telegra.ph/Politika-konfidencialnosti-09-03-91
TERMS_URL=https://telegra.ph/Polzovatelskoe-soglashenie-09-03-40

# Reminder schedule (do not change unless TZ changes)
REMINDER_DAYS_BEFORE=3,1
